# Local defaults
NEUROAD_STORAGE_DIR=./storage
NEUROAD_DB_PATH=./storage/neuroad.db
NEUROAD_WORKERS=1
NEUROAD_LOCAL_EXTRACTOR_WORKERS=3
NEUROAD_ENABLE_EXTRACTOR_CACHE=1
NEUROAD_MAX_UPLOAD_MB=200
NEUROAD_MAX_SOURCE_SECONDS=600
NEUROAD_MAX_ANALYSIS_SECONDS=600
NEUROAD_MODEL_DIR=./models
NEUROAD_ENABLE_TRANSCRIPTION=1
NEUROAD_TRANSCRIPTION_ENGINE=faster_whisper
NEUROAD_REQUIRE_TRANSCRIPTION=0
NEUROAD_ENABLE_OBJECT_DETECTION=1
NEUROAD_OBJECT_DETECTION_ENGINE=yolo
NEUROAD_REQUIRE_OBJECT_DETECTION=0
VOSK_MODEL_DIR=./models/vosk-model-small-en-us-0.15
MOBILENET_SSD_GRAPH=./models/mobilenet-ssd/frozen_inference_graph.pb
MOBILENET_SSD_CONFIG=./models/mobilenet-ssd/ssd_mobilenet_v1_coco.pbtxt
MEDIAPIPE_FACE_MODEL=./models/face_landmarker.task
NEUROAD_ENABLE_OCR=1
NEUROAD_OCR_LANGUAGES=en,devanagari
NEUROAD_ENABLE_SILERO_VAD=1
NEUROAD_ENABLE_LIBROSA=1
NEUROAD_ENABLE_SEMANTIC_MODELS=1
NEUROAD_SENTENCE_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
NEUROAD_GLINER_MODEL=urchade/gliner_multi-v2.1
# Required only for protected evidence-review admin endpoints.
# NEUROAD_REVIEW_API_KEY=

# Add the deployed Netlify origin after the frontend site is created.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-netlify-site.netlify.app

# Optional PostHog server-side lifecycle analytics.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_DEBUG=false
NEUROAD_ENVIRONMENT=production

WHISPER_MODEL=small
YOLO_MODEL=./models/yolo26s.pt
YOLOE_MODEL=./models/yoloe-26l-seg.pt
NEUROAD_YOLO_CONFIDENCE=0.25
NEUROAD_YOLO_IMAGE_SIZE=640
NEUROAD_ENABLE_OCR=1
NEUROAD_YOLOE_PROMPTS=person,product packaging,bottle,box,packet,sachet,tube,jar,can,cosmetics,clothing,electronics,food product,brand logo

# Optional YouTube metadata/ingestion settings.
# YOUTUBE_API_KEY=
# YTDLP_COOKIES_FILE=/data/neuroad/cookies.txt
# YTDLP_COOKIES_BROWSER=chrome

# Optional RunPod GPT-OSS evidence synthesis. Keep RUNPOD_API_KEY server-side.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RUNPOD_BASE_URL=https://api.runpod.ai/v2/your-endpoint-id/openai/v1
RUNPOD_MODEL=neuroad-reasoner
RUNPOD_TIMEOUT_SECONDS=300
RUNPOD_MAX_TOKENS=2500
RUNPOD_MAX_RETRIES=2
NEUROAD_ENABLE_RUNPOD_INSIGHTS=1
NEUROAD_REQUIRE_RUNPOD_INSIGHTS=0
NEUROAD_INSIGHT_WORKERS=1
NEUROAD_INSIGHT_JOB_MAX_ATTEMPTS=3
