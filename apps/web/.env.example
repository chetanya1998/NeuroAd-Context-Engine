# Set this in Netlify/Vercel after the FastAPI backend is deployed.
# Do not use http://localhost:8000 for a public website.
NEXT_PUBLIC_API_BASE=https://api.your-domain.com

# Optional PostHog product analytics. The project token is intended for browser use.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_APP_ENV=production

# Netlify setting for safer Next.js deploy rollouts.
NETLIFY_NEXT_SKEW_PROTECTION=true
