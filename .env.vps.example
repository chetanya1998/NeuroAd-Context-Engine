# Public API domain handled by Caddy. This should point DNS A/AAAA records to the VPS.
API_DOMAIN=api.your-domain.com

# Public frontend origins allowed to call the API. Add your deployed web URL here.
CORS_ORIGINS=https://your-web-domain.com,https://your-netlify-site.netlify.app,http://localhost:3000,http://127.0.0.1:3000

NEUROAD_MAX_UPLOAD_MB=200
NEUROAD_MAX_SOURCE_SECONDS=600
NEUROAD_MAX_ANALYSIS_SECONDS=600
NEUROAD_LOCAL_EXTRACTOR_WORKERS=3
NEUROAD_ENABLE_EXTRACTOR_CACHE=1

# YOLOX-Nano ONNX is the production default. Set yolo/yoloe only after you
# confirm either AGPL compliance or an applicable Ultralytics enterprise license.
NEUROAD_OBJECT_DETECTION_ENGINE=yolox_onnx
NEUROAD_YOLOX_INPUT_SIZE=416
NEUROAD_YOLOX_CONFIDENCE=0.25
NEUROAD_YOLOX_NMS_THRESHOLD=0.45
NEUROAD_ULTRALYTICS_LICENSE_ACCEPTED=0

# Protects evidence-review workflow endpoints.
NEUROAD_REVIEW_API_KEY=replace-with-a-long-random-secret

# Optional YouTube settings.
# YOUTUBE_API_KEY=
# YTDLP_COOKIES_FILE=/data/neuroad/cookies.txt

# Optional RunPod GPT-OSS evidence synthesis.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RUNPOD_BASE_URL=https://api.runpod.ai/v2/your-endpoint-id/openai/v1
RUNPOD_MODEL=neuroad-reasoner
RUNPOD_TIMEOUT_SECONDS=300
RUNPOD_MAX_TOKENS=2500
RUNPOD_MAX_RETRIES=2
NEUROAD_ENABLE_RUNPOD_INSIGHTS=0
NEUROAD_REQUIRE_RUNPOD_INSIGHTS=0
NEUROAD_INSIGHT_WORKERS=1
NEUROAD_INSIGHT_JOB_MAX_ATTEMPTS=3
NEUROAD_ENABLE_OCR=1
NEUROAD_YOLO_CONFIDENCE=0.25
